datasource db { 
  provider = "mysql" 
  url      = env("DATABASE_URL") 
} 
generator client { 
  provider = "prisma-client-js" 
} 
  
model Chambres { 
  id  Int @id @default(autoincrement()) 
  hotel Hotel @relation(fields: [hotel_Id], references: [id])//ne sert que pour prisma
  hotel_Id  Int
  numero String
  categorie String
  capacite Int 
  prix_nuit Int
  description String
  disponible Boolean

  Reservation Reservation[]

} 
  
model Reservation { 
  id       Int       @id @default(autoincrement()) 
Comptes Comptes @relation(fields: [voyageur_id], references: [id])
voyageur_id Int
Chambres Chambres @relation(fields: [chambre_id], references: [id])
chambre_id Int
date_arrivee DateTime @default(now())
date_depart DateTime @default(now())
nb_personnes Int
statut String //@default("en_attente")
demande_special String?
} 

model Comptes{
id Int @id @default(autoincrement())
role String 
email String @unique 
mot_de_passe_clair String 
nom String 
prenom String
hotel Hotel? @relation(fields: [hotel_Id], references: [id])//ne sert que pour prisma
hotel_Id  Int?
telephone String?

Reservation Reservation[]
}
  
model Hotel { 
  id          Int      @id @default(autoincrement()) 
  nom       String  
  etoiles    Int 
  adresse   String
  code_postal String
  ville String
  telephone String
  email String @unique
  gerant String 
  description String

  chambres    Chambres[]
  Comptes Comptes[]
} 
