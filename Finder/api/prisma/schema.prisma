datasource db { 
  provider = "mysql" 
  url      = env("DATABASE_URL") 
} 
generator client { 
  provider = "prisma-client-js" 
} 
  
model Chambres { 
  id  Int @id @default(autoincrement()) 
  hotel Hotels @relation(fields: [hotelId], references: [id])//ne sert que pour prisma
  hotelId  Int @map("hotel_id")
  numero String
  categorie String
  capacite Int 
  prixNuit Int @map("prix_nuit")
  description String
  disponible Boolean

  Reservation Reservations[]

} 
  
model Reservations { 
id       Int       @id @default(autoincrement()) 
Comptes Comptes @relation(fields: [voyageurId], references: [id])
voyageurId Int @map("voyageur_id")
Chambres Chambres @relation(fields: [chambreId], references: [id])
chambreId Int @map("chambre_id")
dateArrivee DateTime @default(now()) @map("date_arrivee")
dateDepart DateTime @default(now()) @map("date_depart")
nbPersonnes Int @map("nb_personnes")
statut String //@default("en_attente")
demandeSpecial String? @map("demande_special")
} 

model Comptes{
id Int @id @default(autoincrement())
role String 
email String @unique 
motDePasse String @map("mot_de_passe")
nom String 
prenom String
hotel Hotels? @relation(fields: [hotelId], references: [id])//ne sert que pour prisma
hotelId  Int? @map("hotel_id")
telephone String?
note String?

Reservation Reservations[]
}
  
model Hotels { 
  id          Int      @id @default(autoincrement()) 
  nom       String  
  etoiles    Int 
  adresse   String
  codePostal String @map("code_postal")
  ville String
  telephone String
  email String @unique
  gerant String 
  description String

  chambres    Chambres[]
  Comptes Comptes[]
}